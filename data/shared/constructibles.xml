<?xml version="1.0" encoding="utf-8"?>
<!-- Metropolis Ascendant - shared constructible adjacency definitions. HAND-AUTHORED (static; not emitted by
     tools/gen-ascendant.ps1, which owns the per-age modifiers/traditions). Registered in every age ActionGroup
     in the modinfo, BEFORE modifiers.xml, so the rule exists when the wonder-lane modifiers reference it.

     MA_WonderHappiness (wonder-lane piece "C"): a BUILDING adjacent to a Wonder district gains +1 Happiness.
     RequiresActivation -> inert until ACTIVATED per city by data/<age>/modifiers.xml (one binary modifier per
     hemisphere, MA_<age>_WONDER_HAPPY_ADJ, EFFECT_CITY_ACTIVATE_CONSTRUCTIBLE_ADJACENCY). BINARY benefit, gated
     ONLY on the tall model (SOLO) - no tech-node gate (static-world property must not blink off at Age transitions)
     and no population scaling. To change the magnitude, edit YieldChange below (the modifier just flips it on).
     Recipe mirrors the base-game Classical Revival tradition (TRADITION_EX_ATTRIBUTE_CULTURAL_01 /
     ExAttributeCultural01WonderHappiness in age-exploration/data/constructibles-shared.xml).

     MA_MtnCul#/MA_MtnGold# (mountain-lane piece "B"): the Machu-Picchu WILDCARD - every Building AND Wonder adjacent
     to a Mountain gains +# Culture / +# Gold (no ConstructibleClass = wildcard, applies to all constructibles, exactly
     like MachuPikchuWildcardMountainCulture). Three values (1/2/3) per yield so each Age activates only its own rule
     (AQ->MtnCul1, EX->MtnCul2, MO->MtnCul3) for clean +1/+2/+3 by Age without stacking. Activated per-hemisphere by
     MA_<age>_MTN_ADJ_CUL/GOLD (M-MountainAdj), gated on Arcadia discovery + tall.

     MA_CoastGold#/MA_RiverProd# ("Arcadia embraces the waters", Option 1): the same wildcard model for WATER - every
     Building AND Wonder adjacent to Coast gains +# Gold, adjacent to a Navigable River gains +# Production. Three
     values (1/2/3) so each Age activates only its own rule (clean +1/+2/+3, no stacking). Activated per-hemisphere by
     MA_<age>_WATER_ADJ_GOLD/PROD (M-WaterAdj), gated on Arcadia discovery + tall. AdjacentTerrain column names
     (TERRAIN_COAST / TERRAIN_NAVIGABLE_RIVER) verified vs base data (AnjuvannamCoastGold, CandiBentarRiverCulture). -->
<Database>
	<Adjacency_YieldChanges>
		<Row ID="MA_WonderHappiness" YieldType="YIELD_HAPPINESS" YieldChange="1" TilesRequired="1" AdjacentDistrict="DISTRICT_WONDER"/>
		<Row ID="MA_MtnCul1"  YieldType="YIELD_CULTURE" YieldChange="1" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_MOUNTAIN"/>
		<Row ID="MA_MtnCul2"  YieldType="YIELD_CULTURE" YieldChange="2" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_MOUNTAIN"/>
		<Row ID="MA_MtnCul3"  YieldType="YIELD_CULTURE" YieldChange="3" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_MOUNTAIN"/>
		<Row ID="MA_MtnGold1" YieldType="YIELD_GOLD"    YieldChange="1" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_MOUNTAIN"/>
		<Row ID="MA_MtnGold2" YieldType="YIELD_GOLD"    YieldChange="2" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_MOUNTAIN"/>
		<Row ID="MA_MtnGold3" YieldType="YIELD_GOLD"    YieldChange="3" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_MOUNTAIN"/>
		<Row ID="MA_CoastGold1" YieldType="YIELD_GOLD"       YieldChange="1" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_COAST"/>
		<Row ID="MA_CoastGold2" YieldType="YIELD_GOLD"       YieldChange="2" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_COAST"/>
		<Row ID="MA_CoastGold3" YieldType="YIELD_GOLD"       YieldChange="3" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_COAST"/>
		<Row ID="MA_RiverProd1" YieldType="YIELD_PRODUCTION" YieldChange="1" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_NAVIGABLE_RIVER"/>
		<Row ID="MA_RiverProd2" YieldType="YIELD_PRODUCTION" YieldChange="2" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_NAVIGABLE_RIVER"/>
		<Row ID="MA_RiverProd3" YieldType="YIELD_PRODUCTION" YieldChange="3" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_NAVIGABLE_RIVER"/>
		<!-- A1 Frontier Food track (2026-07-14): FOOD-tagged buildings gain Food from an adjacent Mountain /
		     Natural Wonder. Additive tiers - Homesteads activates the "2" rules, Fertile Valleys adds the "1"
		     rules -> +3 cap. Inca IncaMountainFoodAdjacency pattern (ConstructibleTag="FOOD" scope, NOT the
		     every-building wildcard, so it stays tall-safe and doesn't blanket every district). -->
		<Row ID="MA_MtnFood2" YieldType="YIELD_FOOD" YieldChange="2" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_MOUNTAIN"/>
		<Row ID="MA_MtnFood1" YieldType="YIELD_FOOD" YieldChange="1" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_MOUNTAIN"/>
		<Row ID="MA_NWFood2"  YieldType="YIELD_FOOD" YieldChange="2" TilesRequired="1" AdjacentNaturalWonder="true"/>
		<Row ID="MA_NWFood1"  YieldType="YIELD_FOOD" YieldChange="1" TilesRequired="1" AdjacentNaturalWonder="true"/>
		<!-- Antiquity Fertile Valleys MASTERY (Chris 2026-07-14): the frontier's slopes also yield Production. -->
		<Row ID="MA_MtnProd2" YieldType="YIELD_PRODUCTION" YieldChange="2" TilesRequired="1" ProjectMaxYield="true" AdjacentTerrain="TERRAIN_MOUNTAIN"/>
		<Row ID="MA_NWProd2"  YieldType="YIELD_PRODUCTION" YieldChange="2" TilesRequired="1" AdjacentNaturalWonder="true"/>
		<!-- The CUL-branch anchor package rows (MA_Anchor<Yield>#) do NOT live here: their
		     AdjacentConstructible references are AGE-SPECIFIC (Amphitheater/Pavilion/Museum), and a
		     FUTURE age's building fails FK validation in an earlier-age game -> LOAD CRASH (proven
		     2026-07-21: "BUILDING_MUSEUM does not exist" killed an Exploration start). They are
		     emitted per age by gen-ascendancy.ps1 into data/<age>/ascendancy-reqweights.xml. -->
	</Adjacency_YieldChanges>
	<Constructible_WildcardAdjacencies>
		<Row YieldChangeId="MA_WonderHappiness" RequiresActivation="true" ConstructibleClass="BUILDING"/>
		<Row YieldChangeId="MA_MtnCul1"  RequiresActivation="true"/>
		<Row YieldChangeId="MA_MtnCul2"  RequiresActivation="true"/>
		<Row YieldChangeId="MA_MtnCul3"  RequiresActivation="true"/>
		<Row YieldChangeId="MA_MtnGold1" RequiresActivation="true"/>
		<Row YieldChangeId="MA_MtnGold2" RequiresActivation="true"/>
		<Row YieldChangeId="MA_MtnGold3" RequiresActivation="true"/>
		<Row YieldChangeId="MA_CoastGold1" RequiresActivation="true"/>
		<Row YieldChangeId="MA_CoastGold2" RequiresActivation="true"/>
		<Row YieldChangeId="MA_CoastGold3" RequiresActivation="true"/>
		<Row YieldChangeId="MA_RiverProd1" RequiresActivation="true"/>
		<Row YieldChangeId="MA_RiverProd2" RequiresActivation="true"/>
		<Row YieldChangeId="MA_RiverProd3" RequiresActivation="true"/>
		<!-- A1 Frontier Food (un-parked 2026-07-14 after the litmus proved the activate mechanism is
		     single-count): FOOD-tag WILDCARD scope (Inca pattern) - covers every food building across all
		     ages, no per-building age-scope FK crash. Activated on the Ascendancy Expansion nodes. -->
		<Row YieldChangeId="MA_MtnFood2" RequiresActivation="true" ConstructibleTag="FOOD"/>
		<Row YieldChangeId="MA_MtnFood1" RequiresActivation="true" ConstructibleTag="FOOD"/>
		<Row YieldChangeId="MA_NWFood2"  RequiresActivation="true" ConstructibleTag="FOOD"/>
		<Row YieldChangeId="MA_NWFood1"  RequiresActivation="true" ConstructibleTag="FOOD"/>
		<Row YieldChangeId="MA_MtnProd2" RequiresActivation="true" ConstructibleTag="FOOD"/>
		<Row YieldChangeId="MA_NWProd2"  RequiresActivation="true" ConstructibleTag="FOOD"/>
	</Constructible_WildcardAdjacencies>
</Database>
